# Database Configuration
# Automatically detected: runs SQLite on local PC, PostgreSQL in Docker.
# Sæt eksplicit til 'sqlite' eller 'postgres' for at overstyre auto-detektion.
DB_TYPE=
SQLITE_DB_PATH=kaloriekassen.db

# If using DB_TYPE=postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kaloriekassen
DB_USER=kalorie
DB_PASSWORD=kalorie

# Static Google OAuth app config.
# Copy this file to .env and fill in real values locally.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://www.google.com

# Generated by GOOGLE_HEALTH_API/setup_google_health.py.
# Keep the generated token file out of git.
GOOGLE_TOKEN_STORE_PATH=secrets/google_oauth_token.json
