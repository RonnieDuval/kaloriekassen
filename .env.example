# Database Configuration
# Automatically detected: runs SQLite on local PC, PostgreSQL in Docker.
# Sæt eksplicit til 'sqlite' eller 'postgres' for at overstyre auto-detektion.
DB_TYPE=
SQLITE_DB_PATH=kaloriekassen.db

# If using DB_TYPE=postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kaloriekassen
DB_USER=kalorie
DB_PASSWORD=

# Download the OAuth client JSON from Google Cloud Console. Both this file and
# the generated refresh-token file must stay under secrets/ and out of git.
GOOGLE_CLIENT_SECRETS_PATH=secrets/google_api_client_secrets.json
GOOGLE_TOKEN_STORE_PATH=secrets/google_oauth_token.json
GOOGLE_HEALTH_DEFAULT_TIMEZONE=Europe/Copenhagen
# Lokal kørsel må åbne browseren. Docker Compose overstyrer denne til false.
GOOGLE_OAUTH_INTERACTIVE=true

# Withings OAuth files. Both stay under secrets/ and out of git.
WITHINGS_CLIENT_SECRETS_PATH=secrets/withings_api_client.json
WITHINGS_TOKEN_STORE_PATH=secrets/withings_oauth_token.json

# Optional: run OAuth locally and upload client/token JSON through the existing
# OpenSSH installation. Authentication uses the normal SSH key and known_hosts.
OAUTH_UPLOAD_TO_NAS=false
OAUTH_DELETE_LOCAL_TOKEN_AFTER_UPLOAD=true
NAS_SSH_HOST=nas
NAS_SSH_USER=
NAS_SSH_PORT=22
NAS_SECRETS_DIR=/volume1/docker/kaloriekassen/secrets
# Usually blank when ssh bruger@nas already works. Otherwise set a key path.
NAS_SSH_IDENTITY_FILE=

# Host directory mounted at /app/secrets by Docker Compose.
SECRETS_DIR=./secrets

# Scheduler configuration for Docker/NAS operation.
SCHEDULER_TIMEZONE=Europe/Copenhagen
SYNC_DAYS=7
INTERVALS_SYNC_MINUTES=30
MFP_SYNC_HOURS=3
GOOGLE_HEALTH_READ_HOURS=6
GOOGLE_HEALTH_DAILY_HOURS=6
WITHINGS_SYNC_HOURS=6
