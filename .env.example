# Kaloriekassen environment configuration
#
# Copy this file to .env on the computer and on the NAS, then fill in the
# values marked REQUIRED. Never commit .env or anything under secrets/.
# Paths in this file are interpreted by the process that reads them:
# - Local CLI paths are relative to the project directory on the computer.
# - Docker Compose overrides OAuth paths with /app/secrets/... in the container.


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Leave blank for automatic selection: SQLite locally and PostgreSQL in Docker.
# Set explicitly to sqlite or postgres only when overriding that behaviour.
DB_TYPE=

# Used only by local SQLite runs.
SQLITE_DB_PATH=kaloriekassen.db

# PostgreSQL. Docker Compose overrides DB_HOST to the service name "db".
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kaloriekassen
DB_USER=kalorie
# REQUIRED on NAS. Use a long, unique password; quotes are allowed.
DB_PASSWORD=

# Optional host publication for pgAdmin. The application containers still use
# db:5432 internally. Bind to the NAS LAN address only when remote access is
# needed; 127.0.0.1 keeps PostgreSQL local to the Docker host.
DB_BIND_ADDRESS=127.0.0.1
DB_HOST_PORT=55432


# ---------------------------------------------------------------------------
# Intervals.icu
# ---------------------------------------------------------------------------

# REQUIRED for Intervals sync. Find both values in Intervals.icu settings.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=


# ---------------------------------------------------------------------------
# MyFitnessPal
# ---------------------------------------------------------------------------

# REQUIRED for MFP sync. Copy the complete Cookie header from a successful
# diary request in browser DevTools. Keep the value quoted if it contains
# spaces or special characters.
MFP_COOKIE_HEADER=""


# ---------------------------------------------------------------------------
# Google Health OAuth
# ---------------------------------------------------------------------------

# Local client JSON downloaded from Google Cloud Console and the token file
# generated by `kaloriekassen google-health-auth`.
GOOGLE_CLIENT_SECRETS_PATH=secrets/google_api_client_secrets.json
GOOGLE_TOKEN_STORE_PATH=secrets/google_oauth_token.json
GOOGLE_HEALTH_DEFAULT_TIMEZONE=Europe/Copenhagen

# true on the computer. Docker Compose always overrides it to false so the
# headless scheduler records an auth failure instead of opening a browser.
GOOGLE_OAUTH_INTERACTIVE=true


# ---------------------------------------------------------------------------
# Withings OAuth
# ---------------------------------------------------------------------------

# Local client JSON and the rotating token file generated by
# `kaloriekassen withings-auth`.
WITHINGS_CLIENT_SECRETS_PATH=secrets/withings_api_client.json
WITHINGS_TOKEN_STORE_PATH=secrets/withings_oauth_token.json


# ---------------------------------------------------------------------------
# OAuth upload from computer to NAS through SSH/SCP port 22
# ---------------------------------------------------------------------------

# Set true in the computer's .env to upload Google and Withings client/token
# files after explicit auth commands. Keep false in the NAS .env; Compose also
# overrides it to false inside the scheduler container.
OAUTH_UPLOAD_TO_NAS=false

# Delete only the local token file after every artifact has been uploaded and
# atomically renamed successfully. Client JSON files remain on the computer.
OAUTH_DELETE_LOCAL_TOKEN_AFTER_UPLOAD=true

# REQUIRED on the computer when upload is enabled. These values correspond to
# the working command `ssh NAS_SSH_USER@NAS_SSH_HOST`.
NAS_SSH_HOST=nas
NAS_SSH_USER=
NAS_SSH_PORT=22

# Optional password for fully unattended SSH/SCP uploads. Put the real value
# only in .env; this example file is committed and must remain blank.
NAS_SSH_PASSWORD=

# REQUIRED when upload is enabled. Absolute directory on the NAS host—not the
# /app/secrets path seen inside the container. It must already exist, and the
# SSH user must have write permission.
NAS_SECRETS_DIR=/volume1/docker/kaloriekassen/secrets

# Usually blank when `ssh bruger@nas` already works. Otherwise set the local
# path to the private SSH key. Do not put the private key itself in .env.
NAS_SSH_IDENTITY_FILE=


# ---------------------------------------------------------------------------
# Docker Compose on NAS
# ---------------------------------------------------------------------------

# Absolute NAS host directory bind-mounted into the container as /app/secrets.
# It will normally be the same physical directory as NAS_SECRETS_DIR.
SECRETS_DIR=/volume1/docker/kaloriekassen/secrets

# IANA timezone used by PostgreSQL and the scheduler container.
SCHEDULER_TIMEZONE=Europe/Copenhagen

# Read-only dashboard. Bind to the NAS LAN address to open it to the local
# network, for example 192.168.1.11. Do not expose it directly to the internet.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088


# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------

# Number of recent days requested by scheduled sync jobs.
SYNC_DAYS=7

# Each interval must be a positive whole number.
INTERVALS_SYNC_MINUTES=30
MFP_SYNC_HOURS=3
GOOGLE_HEALTH_READ_HOURS=6
GOOGLE_HEALTH_DAILY_HOURS=6
GOOGLE_HEALTH_TODAY_MINUTES=15
WITHINGS_SYNC_HOURS=6
