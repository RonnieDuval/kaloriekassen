import datetime as dt
import re
import bs4
import browser_cookie3
import requests

def hent_kalorier_let(dato_streng="2026-05-13"):
    url = f"https://www.myfitnesspal.com/food/diary?date={dato_streng}"
    
    # Standard headers for at ligne en rigtig browser
    headers = {
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8",
        "Accept-Language": "da,en-US;q=0.7,en;q=0.3",
    }

    try:
        # Henter cookies direkte fra Chromes databasefil på disken (virker selvom Chrome er lukket)
        cj = browser_cookie3.chrome(domain_name=".myfitnesspal.com")
        
        response = requests.get(url, headers=headers, cookies=cj, timeout=15)
        
        if response.status_code != 200:
            print(f"[FEJL] Svarede med statuskode: {response.status_code}")
            return None

        soup = bs4.BeautifulSoup(response.text, "html.parser")
        
        # Finder bund-rækkerne ud fra dit DevTools-screenshot
        total_rows = soup.find_all("tr", class_="bottom")
        
        if not total_rows:
            print("[WARN] Kunne ikke finde nogen 'tr.bottom'. Sessionen kan være udløbet.")
            return {"date": dato_streng, "calories": 0, "carbohydrates": 0, "fat": 0, "protein": 0}

        nutrition_payload = None

        for row in total_rows:
            cells = [td.get_text().strip().replace("\xa0", "") for td in row.find_all("td")]
            
            # Tjekker om rækken har data, og om celle 1 rent faktisk indeholder tal
            if len(cells) > 1 and cells[1] != "" and re.search(r"\d+", cells[1]):
                
                # Napper udelukkende det FØRSTE tal i cellen, så spiste og resterende kcal/makroer ikke mases sammen
                def rens_første_tal(tekst):
                    match = re.search(r"(-?\d[\d,.]*)", tekst)
                    if match:
                        rent_tal = match.group(1).replace(",", "").replace(".", "")
                        return int(rent_tal)
                    return 0

                nutrition_payload = {
                    "date": dato_streng,
                    "calories": rens_første_tal(cells[1]),
                    "carbohydrates": rens_første_tal(cells[2]),
                    "fat": rens_første_tal(cells[3]),
                    "protein": rens_første_tal(cells[4]),
                }
                break

        if not nutrition_payload:
            nutrition_payload = {"date": dato_streng, "calories": 0, "carbohydrates": 0, "fat": 0, "protein": 0}

        return nutrition_payload

    except Exception as e:
        print(f"[FEJL] Noget gik galt under parsing: {e}")
        return None

if __name__ == "__main__":
    data = hent_kalorier_let("2026-05-13")
    print("\nResultat udtrukket via baggrunds-cookies:")
    print(data)
